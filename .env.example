# DockerConverter 环境变量配置
# 复制此文件为 .env 后修改对应值

# ── 服务配置 ───────────────────────────────────────────────
PORT=5000
HOST=127.0.0.1

# ── 安全配置 ───────────────────────────────────────────────
# Flask SECRET_KEY，用于签名 session cookie（生产环境务必修改！）
SECRET_KEY=

# ── 默认管理员（首次启动时自动创建，仅当数据库为空时生效）───
# 如果已有用户，此配置不生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 数据库 ─────────────────────────────────────────────────
# 数据库文件路径（可选，默认使用 data/converter.db）
# DATABASE_URI=sqlite:///data/converter.db
